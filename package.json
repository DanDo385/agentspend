{
  "name": "agentspend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first agent spend control plane: policy, approval, receipts. No custody.",
  "bin": {
    "agentspend": "./dist/cli.js"
  },
  "scripts": {
