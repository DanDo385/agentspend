{
  "name": "agentspend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first agent spend control plane: policy, approval, receipts. No custody.",
  "bin": {
    "agentspend": "./dist/cli.js",
    "agentspend-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  }
}
